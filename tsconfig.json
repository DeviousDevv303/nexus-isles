{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ]
  },
  "include": [
    "ledger/**/*.ts",
    "engine/**/*.ts",
    "seats/**/*.ts",
    "actions/**/*.ts",
    "lineage/**/*.ts",
    "console/**/*.ts",
    "observer/**/*.ts",
    "protocol/**/*.ts",
    "residents/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "runner/**/*.ts"
  ]
}
